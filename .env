# ============================================================
#  Jastip Center — konfigurasi environment (LOKAL, jangan di-commit)
#  Disalin dari .env.example.
#
#  Expo meng-inline variabel berawalan EXPO_PUBLIC_ ke dalam bundle.
#  Perubahan .env baru berlaku setelah build ulang (expo export / run).
# ============================================================

# Endpoint umum (dipakai Android/iOS).
EXPO_PUBLIC_API_URL=https://api.jastipcenter.com

# Override khusus WEB/PWA. Kosongkan bila ingin memakai EXPO_PUBLIC_API_URL.
# Saat testing lokal, arahkan ke backend development:
EXPO_PUBLIC_API_URL_WEB=http://100.76.39.97:8081
