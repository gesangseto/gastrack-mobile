# ============================================================
#  Konfigurasi environment untuk BUILD PRODUCTION (PWA).
#  Expo membaca file ini otomatis saat NODE_ENV=production
#  (yaitu saat menjalankan: npx expo export -p web).
#
#  Dipakai oleh deploy di /var/www/pwa (port 82).
# ============================================================

# Endpoint backend production.
EXPO_PUBLIC_API_URL=https://api.fiorellaza.com

# Web/PWA production juga memakai backend production.
EXPO_PUBLIC_API_URL_WEB=https://api.fiorellaza.com