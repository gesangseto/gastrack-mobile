# ============================================================
#  Jastip Center — contoh konfigurasi environment
#  Salin file ini menjadi .env lalu sesuaikan nilainya:
#      cp .env.example .env
#
#  Hanya variabel berawalan EXPO_PUBLIC_ yang dikirim ke bundle
#  aplikasi. JANGAN menaruh password/secret di sini karena ikut
#  ter-inline ke bundle dan bisa dibaca pengguna.
# ============================================================

# Endpoint umum (dipakai Android/iOS).
#   Production: https://api.jastipcenter.com
#   Dev lokal : http://192.168.0.192:8081
EXPO_PUBLIC_API_URL=https://api.jastipcenter.com

# Override khusus WEB/PWA (opsional).
# Kosongkan/hapus bila web ingin memakai EXPO_PUBLIC_API_URL.
#   Testing lokal: http://192.168.0.192:8081
#   Production   : https://api.jastipcenter.com
EXPO_PUBLIC_API_URL_WEB=
